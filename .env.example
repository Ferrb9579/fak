# Copy this file to .env for local development, or export these variables
# in your shell. Never commit real API keys.

NVIDIA_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

NVIDIA_MODEL=google/gemma-4-31b-it
CEREBRAS_MODEL=llama3.1-8b
GEMINI_MODEL=gemma-4-31b-it
GROQ_MODEL=llama-3.3-70b-versatile

# Set to local to use the embedded llama.cpp model.
FAK_PROVIDER=local
